# Server Configuration
PORT=5001
NODE_ENV=production
APP_URL=https://your-backend-name.up.railway.app
CLIENT_URL=https://your-frontend-name.vercel.app

# Database & Redis (Railway provisions these automatically, point to Railway PostgreSQL and Redis)
DATABASE_URL="postgresql://postgres:password@host:5432/railway?schema=public"
REDIS_URL="redis://default:password@host:6379"

# Security & Encryption Keys
JWT_SECRET="generate-a-secure-random-jwt-secret-key-here"
ENCRYPTION_MASTER_KEY="generate-a-64-character-hex-string-for-aes256gcm-tokens"

# Google OAuth 2.0 Credentials (Sign-in & Gmail Account Connection)
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="https://your-backend-name.up.railway.app/api/auth/google/callback"
GMAIL_SEND_REDIRECT_URI="https://your-backend-name.up.railway.app/api/accounts/google/callback"

# AI Personalization Engine
GEMINI_API_KEY="your-gemini-api-key-here"
